{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlanceGuard",
  "version": "0.1.0",
  "identifier": "com.glanceguard.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GlanceGuard",
        "hiddenTitle": true,
        "titleBarStyle": "Transparent",
        "width": 900,
        "height": 660
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data:; font-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://api.glanceguard.app https://updates.glanceguard.app ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://*.sentry.io https://*.ingest.sentry.io https://*.ingest.de.sentry.io"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["dmg", "app"],
    "resources": [
      "models/scrfd.json",
      "models/arcface.json",
      "models/LICENSE.txt",
      "models/det_500m.onnx",
      "models/w600k_mbf.onnx"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "icons/dmg-bg.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      },
      "files": {
        "Resources/PrivacyInfo.xcprivacy": "./PrivacyInfo.xcprivacy"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhENTNBRDA5M0JGRjA4REYKUldUZkNQODdDYTFUamZDQlp5MXNvdE9NUXRyTTVyRVZUTmpIcXNXODNBQ2ZlYldhb2k3WkRBY04K",
      "endpoints": [
        "https://updates.glanceguard.app/{{target}}/{{current_version}}"
      ]
    }
  }
}
